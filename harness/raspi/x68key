#!/usr/bin/env python3
# x68key <コマンド...> : picokbd (X68000 Z に挿した Pico W キーボード) にキー操作を送る
#   x68key key esc / x68key combo ctrl f11 del / x68key type 'ver' / x68key key enter
#   x68key status : netpipe の Pico (ファーム 0013 以降) の状態を 1 行で表示する (キーは押さない)
#   宛先は PICOKBD (既定は LAN のブロードキャスト 192.168.1.255)、UDP 6869。終わると "ok" を表示する
import os, socket, sys
host = os.environ.get("PICOKBD", "192.168.1.255")
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
s.settimeout(float(os.environ.get("PICOKBD_TIMEOUT", "10")))
s.sendto(" ".join(sys.argv[1:]).encode(), (host, 6869))
try:
    r, a = s.recvfrom(1500)     # status の返事は 100 バイトを超える
    print(r.decode())
    sys.exit(0 if r.startswith(b"ok") else 1)
except socket.timeout:
    print("timeout"); sys.exit(2)
