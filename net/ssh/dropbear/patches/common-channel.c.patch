--- dropbear-2022.83/common-channel.c
+++ x68k/common-channel.c
@@ -422,7 +422,12 @@
 
 	/* Write the first portion of the circular buffer */
 	cbuf_readptrs(cbuf, &circ_p1, &circ_len1, &circ_p2, &circ_len2);
+#if DROPBEAR_X68K
+	/* stdout/stderr はそのチャネルのコンソールの VT100 画面へ (x68k_shim.c、仮想コンソール)。ソケットは素の write */
+	{ extern int x68k_chan_write(int, int, const void *, unsigned int); written = x68k_chan_write(channel->index, fd, circ_p1, circ_len1); }
+#else
 	written = write(fd, circ_p1, circ_len1);
+#endif
 	if (written < 0) {
 		if (errno != EINTR && errno != EAGAIN) {
 			TRACE(("channel IO write error fd %d %s", fd, strerror(errno)))
@@ -734,7 +739,12 @@
 	buf_putint(ses.writepayload, 0);
 
 	/* read the data */
+#if DROPBEAR_X68K
+	/* stdin はそのチャネルのコンソールの送信待ちから (x68k_shim.c、仮想コンソール)。空なら -1/EINTR で EOF にしない */
+	{ extern int x68k_chan_read(int, int, void *, unsigned int); len = x68k_chan_read(channel->index, fd, buf_getwriteptr(ses.writepayload, maxlen), maxlen); }
+#else
 	len = read(fd, buf_getwriteptr(ses.writepayload, maxlen), maxlen);
+#endif
 
 	if (len <= 0) {
 		if (len == 0 || errno != EINTR) {
@@ -1179,6 +1189,10 @@
 	}
 	channel->await_open = 0;
 
+#if DROPBEAR_X68K
+	/* 仮想コンソール (x68k_shim.c): 開けなかったチャネルのコンソールを捨てる (closehandler は呼ばれないので) */
+	{ extern void x68k_vc_openfail(int chan); x68k_vc_openfail(channel->index); }
+#endif
 	remove_channel(channel);
 }
 #endif /* DROPBEAR_LISTENERS */
