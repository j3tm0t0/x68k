-    move.w  #PAL12,%d1                  /* ロゴの輪 (色 12) を 0.5 秒ごとに明るく / 元に */
-    btst    #0,%d3
-    beq     3f
+    move.w  #PAL12,%d1
+    btst    #0,%d0
+    beq     1f
     move.w  #PAL12_PULSE,%d1
-3:
+1:
     move.w  %d1,TPAL+12*2
-    lea.l   %pc@(e_track),%a1
+    divu.w  #STAGE_SEG,%d0
+    swap    %d0
+    move.w  %d0,%d3                     /* 今の区間で ◆ を置く位置 (待ちのとき) */
+    moveq.l #-1,%d2                     /* 今の区間の埋まった数 (-1: 埋めない) */
+    cmpi.w  #1,%d7
+    bne     2f
+    move.l  V_HDR+H_RETRY.w,%d0         /* SMB: 次の再接続まで */
+    beq     2f                          /* 試している最中: ◆ が動く */
+    cmpi.l  #-1,%d0
+    beq     2f
+    cmpi.l  #RETRY_MS,%d0
+    bls     3f
+    move.l  #RETRY_MS,%d0
+3:
+    mulu.w  #STAGE_SEG,%d0
+    addi.l  #RETRY_MS-1,%d0
+    divu.w  #RETRY_MS,%d0               /* 残りの区間 (切り上げ) */
+    moveq.l #STAGE_SEG,%d2
+    sub.w   %d0,%d2                     /* 埋まった数 */
+    bpl     4f
+    moveq.l #0,%d2
+4:
+    cmpi.w  #STAGE_SEG-1,%d2
+    bls     5f
+    moveq.l #STAGE_SEG-1,%d2
+5:
+    move.w  %d2,%d3                     /* ◆ は埋まった先 */
+2:
+    lea.l   %pc@(e_stage),%a1
     moveq.l #C_DIM,%d6
     bsr     cprint
-    moveq.l #0,%d4
-1:
+    moveq.l #0,%d4                      /* 段階 */
+6:
+    moveq.l #C_DIM,%d6                  /* 見出しの色 (moveq は条件を変えるので比べ直す) */
+    cmp.w   %d7,%d4
+    bhi     7f
+    moveq.l #C_TEXT,%d6
+    cmp.w   %d7,%d4
+    beq     7f
+    moveq.l #C_OK,%d6
+7:
+    move.w  %d4,%d0
+    add.w   %d0,%d0
+    lea.l   %pc@(t_stage),%a1
+    adda.w  %a1@(%d0.w),%a1
+    bsr     cprint
+    cmpi.w  #3,%d4
+    beq     9f
+    moveq.l #0,%d5                      /* 区間の中の位置 */
+8:
     lea.l   %pc@(m_rail),%a1
     moveq.l #C_DIM,%d6
-    cmp.w   %d4,%d3
-    bne     2f
+    cmp.w   %d7,%d4
+    bcs     10f                         /* 済んだ区間: 全部水色 */
+    bhi     11f                         /* まだの区間 */
+    cmp.w   %d3,%d5                     /* 今の区間 */
+    bne     12f
     lea.l   %pc@(m_packet),%a1
+    bra     10f
+12:
+    cmp.w   %d2,%d5
+    bge     11f                         /* 埋まった数より先 (d2 = -1 なら全部) */
+10:
     moveq.l #C_OK,%d6
-2:
+11:
     bsr     cprint
+    addq.w  #1,%d5
+    cmpi.w  #STAGE_SEG,%d5
+    bne     8b
     addq.w  #1,%d4
-    cmpi.w  #TRACK_LEN,%d4
-    bne     1b
+    bra     6b
+9:
