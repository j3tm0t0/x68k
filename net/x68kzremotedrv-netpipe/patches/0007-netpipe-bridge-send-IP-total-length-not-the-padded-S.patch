From d3127979c97a3769daa673405072c41190fcb70a Mon Sep 17 00:00:00 2001
From: moto <j3tm0t0@gmail.com>
Date: Wed, 21 Oct 2026 10:31:33 +0900
Subject: [PATCH 7/9] netpipe bridge: send IP total length, not the padded SLIP
 frame

xip.x pads frames to the 60-byte Ethernet minimum and slip.sys sends the
padding, so small packets such as SYN-ACKs were longer than their IP total
length and the bridge dropped every one of them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PrGdt1XK1exBgERrMmLA1u
---
 src/netpipe.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/src/netpipe.c b/src/netpipe.c
index 93ef1d9..adbb8f6 100644
--- a/src/netpipe.c
+++ b/src/netpipe.c
@@ -251,12 +251,14 @@ static void bridge_out(const uint8_t *s, int n)
     for (int i = 0; i < n; i++) {
         uint8_t c = s[i];
         if (c == SLIP_END) {
-            /* IPv4 で、全長 = 受け取った長さ のものだけ出す */
-            if (pos >= 20 && !bad && (pkt[0] >> 4) == 4 && ((pkt[2] << 8) | pkt[3]) == pos) {
-                struct pbuf *p = pbuf_alloc(PBUF_IP, pos, PBUF_POOL);
+            /* IPv4 で、全長 <= 受け取った長さ のものを全長の分だけ出す。xip.x は Ethernet の最小長 (60 バイト) まで
+               詰め物を足し、slip.sys はそれごと送ってくるので、小さいパケット (SYN-ACK など) は全長より長い */
+            int tot = pos >= 20 ? (pkt[2] << 8) | pkt[3] : 0;
+            if (pos >= 20 && !bad && (pkt[0] >> 4) == 4 && tot >= 20 && tot <= pos) {
+                struct pbuf *p = pbuf_alloc(PBUF_IP, tot, PBUF_POOL);
                 if (p != NULL) {
                     ip4_addr_t dst;
-                    pbuf_take(p, pkt, pos);
+                    pbuf_take(p, pkt, tot);
                     memcpy(&dst, &pkt[16], 4);
                     cyw43_arch_lwip_begin();
                     etharp_output(wifi, p, &dst);   /* LAN の外ならゲートウェイの MAC で出す */
