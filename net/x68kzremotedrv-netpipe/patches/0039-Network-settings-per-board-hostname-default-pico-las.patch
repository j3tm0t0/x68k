+        }
     } else if (memcmp(&config_flash_addr[0], CONFIG_FLASH_MAGIC_v3, sizeof(CONFIG_FLASH_MAGIC_v3)) == 0) {
-        for (i = 0; i < CONFIG_ITEMS - 1; i++) {
