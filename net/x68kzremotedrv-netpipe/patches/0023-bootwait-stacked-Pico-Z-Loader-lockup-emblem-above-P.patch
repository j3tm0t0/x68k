+    move.w  %a3@+,%d2                   /* バイト幅 - 1 */
+    move.w  %a3@+,%d3                   /* ラスタ数 - 1 */
+    move.w  %a3@+,%d0                   /* データの位置 */
+    lea.l   %pc@(art_blits),%a0
+    adda.w  %d0,%a0
 2:
+    movea.l %a1,%a2
+    move.w  %d2,%d0
+3:
     move.b  %a0@+,%a2@+
-    dbra    %d0,2b
+    dbra    %d0,3b
     lea.l   %a1@(128),%a1
-    dbra    %d1,1b
+    dbra    %d3,2b
+    bra     1b
+9:
     rts
 
