From 0b1063cdb75db5c9704fdd8f6727266de1569946 Mon Sep 17 00:00:00 2001
From: moto <j3tm0t0@gmail.com>
Date: Fri, 23 Oct 2026 17:28:19 +0900
Subject: [PATCH] bootwait: the waiting screen names the real board (Raspberry
 Pi Pico 2 W on RP2350)

mkbootwait.py takes the board name from BW_BOARD; bootwait_gen_p2w.S is the Pico 2 W variant,
assembled as bootwait_p2w.inc and used when PICO_RP2350. The Pico W image is byte-identical to before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PrGdt1XK1exBgERrMmLA1u
---
 driver/Makefile           |   9 +-
 driver/bootwait.S         |   4 +
 driver/bootwait_gen_p2w.S | 841 ++++++++++++++++++++++++++++++++++++++
 driver/mkbootwait.py      |   3 +-
 src/bootwait.c            |   5 +
 5 files changed, 860 insertions(+), 2 deletions(-)
 create mode 100644 driver/bootwait_gen_p2w.S

diff --git a/driver/Makefile b/driver/Makefile
index b79fd73..df3e6fa 100644
--- a/driver/Makefile
+++ b/driver/Makefile
@@ -51,7 +51,7 @@ ifneq ($(DEBUG),)
 CFLAGS += -DDEBUG
 endif
 
-all: scsiremote.inc bootloader.inc hdsboot.inc bootwait.inc bootwait1.inc settingui.inc clrconfig.uf2 zrmtrescue.xdf
+all: scsiremote.inc bootloader.inc hdsboot.inc bootwait.inc bootwait_p2w.inc bootwait1.inc settingui.inc clrconfig.uf2 zrmtrescue.xdf
 
 uitest:
 	$(MAKE) CFLAGS_XTEST=-DXTEST clean settingui.x
@@ -79,6 +79,13 @@ hdsboot.bin: hdsboot.o
 
 bootwait.o: bootwait_gen.S
 
+# Pico 2 W 用 (副題のボード名だけが違う): bootwait_gen_p2w.S は BW_BOARD='Raspberry Pi Pico 2 W' ./mkbootwait.py -o bootwait_gen_p2w.S
+bootwait_p2w.o: bootwait.S bootwait_gen_p2w.S
+	$(CC) $(ASFLAGS) -DBW_P2W -c -o $@ $<
+
+bootwait_p2w.bin: bootwait_p2w.o
+	$(OBJCOPY) -O binary $< $@
+
 bootwait.bin: bootwait.o
 	$(OBJCOPY) -O binary $< $@
 
diff --git a/driver/bootwait.S b/driver/bootwait.S
index 4d45523..9f1213f 100644
--- a/driver/bootwait.S
+++ b/driver/bootwait.S
@@ -653,6 +653,10 @@ m_none:
     .byte   0
     .even
 
+#ifdef BW_P2W
+#include "bootwait_gen_p2w.S"              /* 副題のボード名が Pico 2 W のもの */
+#else
 #include "bootwait_gen.S"
+#endif
 
     .end
