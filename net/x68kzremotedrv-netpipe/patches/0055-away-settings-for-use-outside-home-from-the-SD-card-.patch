             msclog_mark("wifi failed");
@@ -162,7 +164,7 @@ static void connection(int mode)
 
         ip4_addr_t *address = &(cyw43_state.netif[0].ip_addr);
         printf("Connected to %s as %d.%d.%d.%d as host %s\n",
-               config.wifi_ssid,
