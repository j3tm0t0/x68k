             if (lba == 2) {
@@ -436,7 +447,7 @@ int vd_read_block(uint32_t lba, uint8_t *buf)
                 lba -= 0x20 - 2;
             }
             if (hds_cache_read(diskinfo[id].smb2, diskinfo[id].sfh, lba, buf) < 0)
-                return -1;
+                return BOOTWAIT ? VD_IOERR : -1;
             return 0;
         }
 
@@ -537,6 +548,12 @@ static int configtxtlen = 0;
 
 int vd_write_block(uint32_t lba, uint8_t *buf)
 {
+#if BOOTWAIT
+    if (lba == 0x4160) {
+        // "X68000Z/image" directory: Z の Linux がファイルの更新時刻を書き戻すだけ (捨てる)
+        return 0;
+    }
+#endif
     if (lba == 0x4020) {
         // Root directory
         if (memcmp(&buf[32], "CONFIG  TXT", 11) == 0) {
@@ -573,11 +590,17 @@ int vd_write_block(uint32_t lba, uint8_t *buf)
             return -1;
         DPRINTF3("disk %d: write 0x%x\n", id, lba);
 
+#if BOOTWAIT
+        if (diskinfo[id].type == DTYPE_HDS && diskinfo[id].sfh == NULL)
+            return sysstatus >= STAT_CONFIGURED ? VD_IOERR : VD_NOTREADY;
+        if (diskinfo[id].type == DTYPE_REMOTECOMM && lba >= NETPIPE_WLBA && lba < NETPIPE_WLBA + 8)
+            return netpipe_write(lba, buf);     /* netpipe は SMB の接続を待たない */
+#endif
         vd_sync();
 
         if (diskinfo[id].type == DTYPE_HDS && diskinfo[id].sfh != NULL) {
             if (hds_cache_write(diskinfo[id].smb2, diskinfo[id].sfh, lba, buf) < 0)
-                return -1;
+                return BOOTWAIT ? VD_IOERR : -1;
             return 0;
         }
         if (diskinfo[id].type == DTYPE_REMOTECOMM) {
diff --git a/src/virtual_disk.h b/src/virtual_disk.h
index 3af3cbf..9a33f71 100644
--- a/src/virtual_disk.h
+++ b/src/virtual_disk.h
@@ -41,6 +41,16 @@
 #define VOLUME_SECTOR_COUNT (0x20 + FAT_SECTORS * 2 + (MAX_CLUSTER - 2) * CLUS_PER_SECT)
                                                                 // 0x4003fa0
 
+/* BOOTWAIT=1 (既定、cmake -DBOOTWAIT=OFF で外す): HDS がまだ開けていない間の読み書きに 0 埋めの成功ではなく
+   NOT READY を返す (msc_disk.c)。Z の Linux は失敗した読み込みをキャッシュせず、04/01 なら待って出し直す */
+#ifndef BOOTWAIT
+#define BOOTWAIT 0
+#endif
+
+/* vd_read_block / vd_write_block の戻り値。-1 は従来どおり (Z には 0 埋めの成功として見せる) */
+#define VD_NOTREADY         (-2)    /* HDS がまだ開けていない: 少し待たせてから NOT READY (04/01) */
+#define VD_IOERR            (-3)    /* HDS の読み書きに失敗した / HDS が無い: MEDIUM ERROR (03/11) */
+
 /* virtual disk function prototypes */
 
 int vd_init(void);
