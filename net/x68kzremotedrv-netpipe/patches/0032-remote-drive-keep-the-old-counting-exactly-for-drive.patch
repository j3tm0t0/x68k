From f6c605e53412eb3c64e6e9d938b7116f70ffba36 Mon Sep 17 00:00:00 2001
From: moto <j3tm0t0@gmail.com>
Date: Fri, 23 Oct 2026 12:02:03 +0900
Subject: [PATCH] remote drive: keep the old counting exactly for drivers
 without the base (no hang)

0030 also returned a broken signature for out-of-range pages to old drivers (no bit 7). An old
driver (e.g. a scsiremote.sys from a rescue disk) re-reads such a page forever, so after the
8-page shift it would hang instead of reading shifted data. Only reject out-of-range pages when
the driver sent the base; old drivers get exactly the previous behaviour.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PrGdt1XK1exBgERrMmLA1u
---
 src/virtual_disk.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/virtual_disk.c b/src/virtual_disk.c
index 1c0e13a..ef6c27a 100644
--- a/src/virtual_disk.c
+++ b/src/virtual_disk.c
@@ -590,7 +590,8 @@ int vd_read_block(uint32_t lba, uint8_t *buf)
                 }
                 b->header = vdbuf_header;
                 b->header.maxpage = vdbuf_rpages;
-                if (page > vdbuf_rpages || page >= (int)(sizeof(vdbuf_read) / (512 - 16))) {
+                if (vdbuf_rbase >= 0 &&
+                    (page > vdbuf_rpages || page >= (int)(sizeof(vdbuf_read) / (512 - 16)))) {
                     b->header.signature = 0;            /* 先読みなど: driver の照合 (先頭 12 バイト) に通らない */
                     b->header.page = 0xff;
                     memset(b->buf, 0, sizeof(b->buf));
