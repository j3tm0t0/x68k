diff --git a/src/hw_config.c b/src/hw_config.c
new file mode 100644
index 0000000..359be50
--- /dev/null
+++ b/src/hw_config.c
@@ -0,0 +1,56 @@
+/*
+ * hw_config.c -- SD カード (SPI 接続) の配線 (no-OS-FatFS-SD-SDIO-SPI-RPi-Pico 用)
+ *
+ *   SD の基板    Pico W / Pico 2 W (既定。CMake の SD_SCK / SD_MOSI / SD_MISO / SD_CS / SD_SPI_HZ で変えられる)
+ *   3V3          36 番ピン (3V3 OUT)
+ *   GND          38 番ピン
+ *   SCK          GP18 (24 番ピン)
+ *   MOSI (DI)    GP19 (25 番ピン)
+ *   MISO (DO)    GP20 (26 番ピン)
+ *   CS           GP21 (27 番ピン)
+ * Pico 2 WH (2026-10-23): DAT1・DAT2・CS・MISO に 10k の外付けプルアップ (RP2350 の E9)。25MHz で 1MB の書き・読み・照合を
+ * 330 回続けて失敗 0 (x68k-zos pico/test/sdsmoke)、37.5MHz はマウントできなかった
+ * GP0 / GP1 は UART のログ、Wi-Fi (CYW43) は内部の GPIO を使うので、SPI0 の既定の位置が空いている
+ */
+#include "hw_config.h"
+
+#ifndef SD_SCK
+#define SD_SCK      18
+#endif
+#ifndef SD_MOSI
+#define SD_MOSI     19
+#endif
+#ifndef SD_MISO
+#define SD_MISO     20
+#endif
+#ifndef SD_CS
+#define SD_CS       21
+#endif
+#ifndef SD_SPI_HZ
+#define SD_SPI_HZ   (25 * 1000 * 1000)
+#endif
+
+static spi_t spi = {
+    .hw_inst = spi0,
+    .sck_gpio = SD_SCK,
+    .mosi_gpio = SD_MOSI,
+    .miso_gpio = SD_MISO,
+    .baud_rate = SD_SPI_HZ,
+};
+
+static sd_spi_if_t spi_if = {
+    .spi = &spi,
+    .ss_gpio = SD_CS,
+};
+
+static sd_card_t sd_card = {
+    .type = SD_IF_SPI,
+    .spi_if_p = &spi_if,
+};
+
+size_t sd_get_num() { return 1; }
+
+sd_card_t *sd_get_by_num(size_t num)
+{
+    return num == 0 ? &sd_card : NULL;
+}
diff --git a/src/sdhds.c b/src/sdhds.c
new file mode 100644
index 0000000..635d262
--- /dev/null
+++ b/src/sdhds.c
@@ -0,0 +1,142 @@
+/*
+ * sdhds.c -- SD カードの上の HDS ファイル (FatFs、no-OS-FatFS-SD-SDIO-SPI-RPi-Pico)
+ *
+ * Wi-Fi の SMB2 を待たずに起動できる (電源を入れた直後の Wi-Fi / SMB2 の接続が間に合わないと
+ * 「ディスクから起動できません」になっていた)。B: (SCSI ID 6) と netpipe は Wi-Fi がつながってから使える。
+ * HDS の大きさは変えない (書き込みは既存の範囲の中だけ) ので、FAT やディレクトリは書き換わらない。
+ * それでも FatFs の中の 1 セクタ分の書き込みを溜めないよう、書いたら f_sync する
+ */
+#include <stdio.h>
+#include <string.h>
+#include <fcntl.h>
+
+#include "ff.h"
+#include "smb2.h"
+#include "libsmb2.h"
+#include "sdhds.h"
+
+#define SDHDS_MAX   6
+
+static FATFS fs;
+static bool mounted;
+static FIL files[SDHDS_MAX];
+static int nfiles;
+
+bool sdhds_is(const char *path)
+{
+    return strncmp(path, "sd:", 3) == 0;
+}
+
+int64_t sdhds_open(const char *path, void **handle)
+{
+    FRESULT fr;
+    if (!mounted) {
+        if ((fr = f_mount(&fs, "", 1)) != FR_OK) {
+            printf("SD: mount failed (%d)\n", fr);
+            return -1;
+        }
+        mounted = true;
+    }
+    if (nfiles >= SDHDS_MAX)
+        return -1;
+    FIL *f = &files[nfiles];
+    const char *name = path + 3;            /* "sd:" の後ろ */
+    if ((fr = f_open(f, name, FA_READ | FA_WRITE)) != FR_OK) {
+        printf("SD: %s open failed (%d)\n", name, fr);
+        return -1;
+    }
+    nfiles++;
+    *handle = f;
+    return (int64_t)f_size(f);
+}
+
+int sdhds_read(void *handle, uint32_t lba, uint8_t *buf, int nsect)
+{
+    FIL *f = handle;
+    UINT br;
+    if (f_lseek(f, (FSIZE_t)lba * 512) != FR_OK)
+        return -1;
+    if (f_read(f, buf, nsect * 512, &br) != FR_OK)
+        return -1;
+    return br;
+}
+
+int sdhds_write(void *handle, uint32_t lba, const uint8_t *buf, int nsect)
+{
+    FIL *f = handle;
+    UINT bw;
+    if (f_lseek(f, (FSIZE_t)lba * 512) != FR_OK)
+        return -1;
+    if (f_write(f, buf, nsect * 512, &bw) != FR_OK || bw != (UINT)nsect * 512)
+        return -1;
+    if (f_sync(f) != FR_OK)
+        return -1;
+    return bw;
+}
+
+/*
+ * SMB の共有から SD カードへ 1 回だけ写す (Wi-Fi 越しにカードへ HDS を載せる道。カードを抜かずに済む)。
+ * SD に sdpath が無く、共有に smbpath があるときだけ。途中で切れたものを使わないよう、別名に書いてから名前を変える。
+ * 戻り値: 写したバイト数 / 0 (写すものが無い・もうある) / -1 (失敗)
+ */
+int64_t sdhds_fetch(struct smb2_context *smb2, const char *smbpath, const char *sdpath)
+{
+    static uint8_t buf[32768];
+    char tmp[128];
+    FILINFO fi;
+    FIL f;
+    FRESULT fr;
+    struct smb2fh *fh;
+    int64_t total = 0;
+    if (!mounted) {
+        if ((fr = f_mount(&fs, "", 1)) != FR_OK)
+            return -1;
+        mounted = true;
+    }
+    if (f_stat(sdpath, &fi) == FR_OK)
+        return 0;
+    if ((fh = smb2_open(smb2, smbpath, O_RDONLY)) == NULL)
+        return 0;
+    snprintf(tmp, sizeof tmp, "%s.part", sdpath);
+    {
+        /* 親ディレクトリ (1 段だけ) */
+        char d[128];
+        snprintf(d, sizeof d, "%s", sdpath);
+        char *p = strrchr(d, '/');
+        if (p && p != d) {
+            *p = 0;
+            f_mkdir(d);
+        }
+    }
+    if ((fr = f_open(&f, tmp, FA_WRITE | FA_CREATE_ALWAYS)) != FR_OK) {
+        printf("SD: fetch %s: create failed (%d)\n", tmp, fr);
+        smb2_close(smb2, fh);
+        return -1;
+    }
+    printf("SD: fetching %s -> %s\n", smbpath, sdpath);
+    for (;;) {
+        int n = smb2_read(smb2, fh, buf, sizeof buf);
+        UINT bw;
+        if (n < 0) {
+            total = -1;
+            break;
+        }
+        if (n == 0)
+            break;
+        if (f_write(&f, buf, n, &bw) != FR_OK || bw != (UINT)n) {
+            total = -1;
+            break;
+        }
+        total += n;
+    }
+    smb2_close(smb2, fh);
+    if (f_close(&f) != FR_OK)
+        total = -1;
+    if (total < 0 || f_rename(tmp, sdpath) != FR_OK) {
+        printf("SD: fetch %s failed\n", smbpath);
+        f_unlink(tmp);
+        return -1;
+    }
+    printf("SD: fetched %lld bytes to %s (used from the next boot)\n", total, sdpath);
+    return total;
+}
diff --git a/src/sdhds.h b/src/sdhds.h
new file mode 100644
index 0000000..57ee8c0
--- /dev/null
+++ b/src/sdhds.h
@@ -0,0 +1,22 @@
+#ifndef _SDHDS_H_
+#define _SDHDS_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+
+/* config の HDS の指定が "sd:" で始まれば、Pico に SPI でつないだ SD カードの上のファイルを使う */
+bool sdhds_is(const char *path);
+/* SD カードの上のデータ用ディスクの置き場の既定。使うには HDS1 に "sd:/x68000z/hds1.hds" と明示する
+   (SCSI ID 1 が起動時に B: を取るので、リモートドライブは C: にずれる) */
+#define SDHDS_AUTO1     "/x68000z/hds1.hds"
+/* SD に SDHDS_AUTO1 が無く、SMB の共有 (HDS0 と同じ共有) にこれがあれば、起動時に 1 回だけカードへ写す
+   (写すだけで、HDS1 に指定しない限りディスクにはならない) */
+#define SDHDS_FETCH1    "sdcopy/hds1.hds"
+struct smb2_context;
+int64_t sdhds_fetch(struct smb2_context *smb2, const char *smbpath, const char *sdpath);
+/* 開いて大きさ (バイト) を返す。失敗なら -1。戻り値の handle を hds_cache_* に smb2 = NULL で渡す */
+int64_t sdhds_open(const char *path, void **handle);
+int sdhds_read(void *handle, uint32_t lba, uint8_t *buf, int nsect);
+int sdhds_write(void *handle, uint32_t lba, const uint8_t *buf, int nsect);
+
+#endif  /* _SDHDS_H_ */
