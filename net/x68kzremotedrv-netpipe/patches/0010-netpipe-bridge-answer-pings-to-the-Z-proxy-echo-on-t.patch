+/* 16 ビットの 1 の補数の和 (IP / ICMP のチェックサム) */
+static uint16_t cksum(const uint8_t *b, int n)
+{
+    uint32_t s = 0;
+    for (int i = 0; i + 1 < n; i += 2)
+        s += (b[i] << 8) | b[i + 1];
+    if (n & 1)
+        s += b[n - 1] << 8;
+    while (s >> 16)
+        s = (s & 0xffff) + (s >> 16);
+    return ~s & 0xffff;
+}
+
+/* 預かった echo request に、Z の代わりに echo reply を返す (USB タスクで、lwIP のロックの外から呼ぶ) */
+static void echo_reply(void)
+{
+    int tot = echo_len;
+    if (tot == 0)
+        return;
+    uint8_t *ip = echo_pkt;
+    int hl = (ip[0] & 15) * 4;
+    if (hl >= 20 && tot >= hl + 8) {
+        uint8_t t[4];
+        memcpy(t, &ip[12], 4);           /* 送り元と宛先を入れ替える */
+        memcpy(&ip[12], &ip[16], 4);
+        memcpy(&ip[16], t, 4);
+        ip[8] = 64;                      /* TTL */
+        ip[10] = ip[11] = 0;
+        uint16_t c = cksum(ip, hl);
+        ip[10] = c >> 8;
+        ip[11] = c;
+        uint8_t *icmp = ip + hl;
+        icmp[0] = 0;                     /* echo reply */
+        icmp[2] = icmp[3] = 0;
+        c = cksum(icmp, tot - hl);
+        icmp[2] = c >> 8;
+        icmp[3] = c;
+        bridge_send(ip, tot);
+    }
+    __dmb();
+    echo_len = 0;
+}
+
 /* Z から来たレコード ([長さ 2][IP パケット][詰め物]) を 1 個ずつ Wi-Fi に出す */
 static void bridge_out_rec(const uint8_t *s, int n)
 {
@@ -417,6 +472,7 @@ static void np_exchange(void)
                 send_arp(ARP_REPLY, &m, &ip);
             }
