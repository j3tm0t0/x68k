diff --git a/src/usb_descriptors.c b/src/usb_descriptors.c
index cbc6cfd..80eda60 100644
--- a/src/usb_descriptors.c
+++ b/src/usb_descriptors.c
@@ -25,6 +25,7 @@
  */
 
 #include "tusb.h"
+#include "hidkbd.h"
 
 /* A combination of interfaces must have a unique product id, since PC will save device driver after the first plug.
  * Same VID/PID with different interface e.g MSC (first), then CDC (later) will possibly cause system error on PC.
@@ -33,8 +34,17 @@
  *   [MSB]         HID | MSC | CDC          [LSB]
  */
 #define _PID_MAP(itf, n)  ( (CFG_TUD_##itf) << (n) )
+#if HID_KEYBOARD
+/* キーボードを足しても PID は MSC だけのとき (0xCafe:0x4002) のままにし、Z から見た MSC の素性を変えない。
+   区別は bcdDevice で付ける */
+#define USB_PID           (0x4000 | _PID_MAP(CDC, 0) | _PID_MAP(MSC, 1) | \
+                           _PID_MAP(MIDI, 3) | _PID_MAP(VENDOR, 4) )
+#define USB_BCDDEVICE     0x0101
+#else
 #define USB_PID           (0x4000 | _PID_MAP(CDC, 0) | _PID_MAP(MSC, 1) | _PID_MAP(HID, 2) | \
                            _PID_MAP(MIDI, 3) | _PID_MAP(VENDOR, 4) )
+#define USB_BCDDEVICE     0x0100
+#endif
 
 #define USB_VID   0xCafe
 #define USB_BCD   0x0200
@@ -55,7 +65,7 @@ tusb_desc_device_t const desc_device =
 
     .idVendor           = USB_VID,
