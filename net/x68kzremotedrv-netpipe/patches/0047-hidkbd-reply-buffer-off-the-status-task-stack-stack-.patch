From 6eb6f98c9285a4741683c8899e35021d5bef5bee Mon Sep 17 00:00:00 2001
From: moto <j3tm0t0@gmail.com>
Date: Sat, 24 Oct 2026 00:13:49 +0900
Subject: [PATCH] hidkbd: reply buffer off the status task stack (stack 1024
 words); task table of 16

0040 put a 480-byte buffer on the 768-word status task's stack next to its 400-byte line, which
could overflow under UDP 6869 status polling and corrupt the heap. Both callers hold the lwIP
lock, so the buffer is static now. The keepalive task table had room for 8 tasks, and with more
than 8 uxTaskGetSystemState returned nothing; 16 now.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PrGdt1XK1exBgERrMmLA1u
---
 src/connect.c | 2 +-
 src/hidkbd.c  | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/connect.c b/src/connect.c
index ef5e113..ffbc8ab 100644
--- a/src/connect.c
+++ b/src/connect.c
@@ -433,7 +433,7 @@ void keepalive_task(void *params)
         struct tm *tm = localtime(&tt);
         printf("%04d/%02d/%02d %02d:%02d:%02d\n", tm->tm_year + 1900, tm->tm_mon + 1, tm->tm_mday, tm->tm_hour, tm->tm_min, tm->tm_sec);
 
-        static TaskStatus_t pxTaskStatusArray[8];
+        static TaskStatus_t pxTaskStatusArray[16];   /* 8 では足りず (タスクが 9 つ以上) 何も出ていなかった */
         unsigned long ulTotalRunTime;
         int uxArraySize = uxTaskGetSystemState(pxTaskStatusArray, count_of(pxTaskStatusArray), &ulTotalRunTime);
         printf("ID Task Name        S Pr Stack\n");
diff --git a/src/hidkbd.c b/src/hidkbd.c
index c0558b3..b4f136d 100644
--- a/src/hidkbd.c
+++ b/src/hidkbd.c
@@ -73,7 +73,7 @@ static uint32_t due, wait_from;
 /* 返事はどれも最初の語 (ok / err) の直後に host=<ホスト名> を入れる (PZL と同じ形。どの基板の返事か分かる) */
 static void sendto_locked(const char *s, const ip_addr_t *addr, u16_t port)
 {
-    char b[480];
+    static char b[480];                 /* 呼ぶ側はどちらも lwIP の錠の中 (on_udp / cyw43_arch_lwip_begin)。status タスクのスタックに置かない */
     size_t w = strcspn(s, " ");
     int n = snprintf(b, sizeof b, "%.*s host=%s%s", (int)w, s, net_hostname(), s + w);
     if (n < 0)
@@ -217,7 +217,7 @@ static void status_task(void *params)
 
 void hidkbd_init(void)
 {
-    xTaskCreate(status_task, "HidKbdStatus", 768, NULL, 1, &st_th);
+    xTaskCreate(status_task, "HidKbdStatus", 1024, NULL, 1, &st_th);
     sdcopy_init();
     cyw43_arch_lwip_begin();
     kpcb = udp_new();
-- 
