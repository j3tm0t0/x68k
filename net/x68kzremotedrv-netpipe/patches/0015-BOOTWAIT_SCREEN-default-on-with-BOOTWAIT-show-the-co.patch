diff --git a/driver/bootwait.S b/driver/bootwait.S
new file mode 100644
index 0000000..60b4409
--- /dev/null
+++ b/driver/bootwait.S
@@ -0,0 +1,312 @@
+/*
+ * bootwait.S -- 起動待ちの IPL (src/bootwait.c、BOOTWAIT_SCREEN)
+ *
+ * Pico が HDS をまだ開けていないとき、HDS の LBA 2-3 (IPL) の代わりにこれを返す。ほかの LBA 0-31 は
+ * 前回控えた本物なので、Z のキャッシュには本物の分割表と SCSI ドライバが入る。
+ * これは後半 (SCSI ID 6 の LBA BW_STAGE2 から $2800 に読まれる)。前半 bootwait1.S が HDS の LBA 2 に入る。
+ * 画面に Pico の状態を出しながら、SCSI ID 6 の BW_BAND (src/bootwait_proto.h) を毎回違う番地で読み、
+ *   BW_READY   -> 返ってきた本物の IPL (1KB) を $2000 に置いて飛ぶ (ROM から来たときの d4 = SCSI ID を戻す)
+ *   BW_CHANGED -> 「電源を入れ直してください」と出して止まる
+ *   それ以外   -> 状態を出して 0.5 秒後にもう一度
+ * F1 を押すと設定メニュー (hdsboot.S と同じ)。
+ * Unicorn (ホスト試験) は movem を扱えないので使わない。
+ */
+
+    .text
+
+BW_BAND     = 0x40000
+BW_SLOTS    = 12288
+BW_STRIDE_SHIFT = 6                     /* 64 セクタ */
+
+V_ID        = 0x3800                    /* ROM から来たときの d4 (前半が置く) */
+V_T0        = 0x3804                    /* 始めた時刻 (1/100 秒) */
+V_LAST      = 0x3808                    /* 最後に問い合わせた時刻 */
+V_UP        = 0x380c                    /* 最後に受け取った Pico の起動からの ms */
+V_SPIN      = 0x3810
+LINE        = 0x3900                    /* 表示する行を組み立てる */
+BUF         = 0x4000                    /* 応答 3 セクタ */
+
+entry:
+    .ascii  "BW2!"                      /* 前半が確かめる */
+main:
+    moveq.l #0x7f,%d0                   /* ONTIME */
+    trap    #15
+    move.l  %d0,V_T0.w
+    subi.l  #100,%d0
+    move.l  %d0,V_LAST.w                /* 最初はすぐ問い合わせる */
+    clr.l   V_UP.w
+    clr.w   V_SPIN.w
+    lea.l   %pc@(m_screen),%a1
+    moveq.l #0x21,%d0
+    trap    #15
+
+loop:
+    moveq.l #0x04,%d0                   /* B_BITSNS */
+    moveq.l #0x0c,%d1
+    trap    #15
+    andi.b  #0x08,%d0                   /* F1 */
+    bne     loadsetting
+
+    moveq.l #0x7f,%d0                   /* ONTIME */
+    trap    #15
+    move.l  %d0,%d6
+    sub.l   V_LAST.w,%d0
+    bmi     poll                        /* 日付が変わった */
+    cmpi.l  #50,%d0
+    blt     loop
+
+poll:
+    move.l  %d6,V_LAST.w
+    move.l  %d6,%d0                     /* 番地 = BW_BAND + ((時刻 >> 5) mod BW_SLOTS) * 64 */
+    lsr.l   #5,%d0
+    divu.w  #BW_SLOTS,%d0
+    clr.w   %d0
+    swap    %d0
+    lsl.l   #BW_STRIDE_SHIFT,%d0
+    addi.l  #BW_BAND,%d0
+    move.l  %d0,%d2
+    move.l  %d0,%d7
+    moveq.l #3,%d3
+    moveq.l #6,%d4                      /* SCSI ID 6 */
+    moveq.l #1,%d5
+    movea.w #BUF,%a1
+    move.l  #0xf5,%d0
+    moveq.l #0x26,%d1
+    trap    #15
+    tst.l   %d0
+    bne     noresp
+    movea.w #BUF,%a0
+    cmpi.l  #0x58364257,%a0@            /* "X6BW" */
+    bne     noresp
+    cmp.l   %a0@(16),%d7                /* 読んだ番地の答えか */
+    bne     noresp
+    move.l  %a0@(12),%d0
+    cmp.l   V_UP.w,%d0
+    bcs     loop                        /* 前に読んだものより古い (キャッシュ): 見ない */
+    move.l  %d0,V_UP.w
+    move.b  %a0@(4),%d0
+    cmpi.b  #1,%d0
+    beq     ready
+    cmpi.b  #2,%d0
+    beq     changed
+    lea.l   %pc@(m_nohds),%a2
+    cmpi.b  #3,%d0
+    beq     show
+    moveq.l #0,%d0                      /* 待ち: sysstatus で言い分ける */
+    move.b  %a0@(5),%d0
+    cmpi.b  #4,%d0
+    bls     1f
+    moveq.l #4,%d0
+1:
+    add.w   %d0,%d0
+    lea.l   %pc@(t_stat),%a2
+    adda.w  %a2@(%d0.w),%a2
+    bra     show
+
+noresp:
+    clr.l   BUF+8.w                     /* IP は出さない */
+    lea.l   %pc@(m_noresp),%a2
+
+show:                                   /* a2 の文言 + IP + 経過秒 + くるくる */
+    movea.w #LINE,%a3
+    lea.l   %pc@(e_row2),%a4
+    bsr     copystr
+    movea.l %a2,%a4
+    bsr     copystr
+    move.l  BUF+8.w,%d6
+    beq     2f
+    lea.l   %pc@(m_ip),%a4
+    bsr     copystr
+    moveq.l #3,%d5
+1:
+    rol.l   #8,%d6
+    moveq.l #0,%d0
+    move.b  %d6,%d0
+    bsr     putdec
+    move.b  #'.',%a3@+
+    dbra    %d5,1b
+    subq.l  #1,%a3                      /* 最後の '.' */
+2:
+    move.b  #' ',%a3@+
+    move.b  #' ',%a3@+
+    move.l  V_LAST.w,%d0
+    sub.l   V_T0.w,%d0
+    bpl     3f
+    addi.l  #8640000,%d0
+3:
+    cmpi.l  #6553500,%d0
+    bcs     4f
+    move.l  #6553500,%d0
+4:
+    divu.w  #100,%d0
+    andi.l  #0xffff,%d0
+    bsr     putdec
+    lea.l   %pc@(m_sec),%a4
+    bsr     copystr
+    move.w  V_SPIN.w,%d0
+    addq.w  #1,V_SPIN.w
+    andi.w  #3,%d0
+    lea.l   %pc@(m_spin),%a4
+    move.b  %a4@(%d0.w),%a3@+
+    lea.l   %pc@(m_pad),%a4
+    bsr     copystr
+    bsr     print
+    bra     loop
+
+changed:
+    movea.w #LINE,%a3
+    lea.l   %pc@(e_row2),%a4
+    bsr     copystr
+    lea.l   %pc@(m_changed),%a4
+    bsr     copystr
+    lea.l   %pc@(m_pad),%a4
+    bsr     copystr
+    bsr     print
+    bra     halt
+
+ready:                                  /* IPL の和を確かめてから $2000 に写して飛ぶ (ここは $2800 から上) */
+    movea.w #BUF+512,%a1
+    move.w  #255,%d1
+    moveq.l #0,%d0
+1:
+    add.l   %a1@+,%d0
+    dbra    %d1,1b
+    cmp.l   %a0@(20),%d0
+    bne     noresp
+    lea.l   %pc@(e_clear),%a1
+    moveq.l #0x21,%d0
+    trap    #15
+    movea.w #BUF+512,%a0
+    movea.w #0x2000,%a1
+    move.w  #255,%d0
+2:
+    move.l  %a0@+,%a1@+
+    dbra    %d0,2b
+    move.l  V_ID.w,%d4
+    jmp     0x2000.w
+
+halt:
+    bra     halt
+
+/* a4 の文字列 (0 終わり) を a3 に足す */
+copystr:
+    move.b  %a4@+,%d0
+    beq     1f
+    move.b  %d0,%a3@+
+    bra     copystr
+1:
+    rts
+
+/* d0 (0-65535) を 10 進で a3 に足す */
+putdec:
+    moveq.l #0,%d1
+1:
+    divu.w  #10,%d0
+    swap    %d0
+    addi.w  #'0',%d0
+    move.w  %d0,-(%sp)
+    addq.w  #1,%d1
+    clr.w   %d0
+    swap    %d0
+    tst.w   %d0
+    bne     1b
+2:
+    move.w  (%sp)+,%d0
+    move.b  %d0,%a3@+
+    subq.w  #1,%d1
+    bne     2b
+    rts
+
+print:
+    clr.b   %a3@
+    movea.w #LINE,%a1
+    moveq.l #0x21,%d0
+    trap    #15
+    rts
+
+loadsetting:                            /* hdsboot.S と同じ: ID 6 の設定メニューを読んで飛ぶ */
+    move.l  #(0x20000/512),%d2
+    moveq.l #6,%d4
+    moveq.l #1,%d3
+    moveq.l #1,%d5
+    movea.w #0x67c0,%a1
+    move.l  #0xf5,%d0
+    moveq.l #0x26,%d1
+    trap    #15
+    cmpi.w  #0x4855,0x67c0.w
+    bne     halt
+    move.l  0x67cc.w,%d3
+    add.l   0x67d0.w,%d3
+    add.l   #(0x40+511),%d3
+    lsr.l   #8,%d3
+    lsr.l   #1,%d3
+    movea.w #0x67c0,%a1
+    move.l  #0xf5,%d0
+    moveq.l #0x26,%d1
+    trap    #15
+    movea.l 0x67c4.w,%a0
+    adda.l  0x67cc.w,%a0
+    adda.l  0x67d0.w,%a0
+    move.l  0x67d4.w,%d0
+    addq.l  #3,%d0
+    lsr.l   #2,%d0
+    bra     3f
+2:
+    clr.l   %a0@+
+3:
+    dbra    %d0,2b
+    movea.l 0x67c8.w,%a0
+    jmp     %a0@
+
+t_stat:                                 /* sysstatus 0-4 */
+    .word   m_wifi0-t_stat, m_wifi1-t_stat, m_smb0-t_stat, m_smb1-t_stat, m_hds-t_stat
+
+m_screen:
+    .byte   0x1b
+    .ascii  "[2J"
+    .byte   0x1b
+    .ascii  "[12;5H"
+    /* Pico: SMB 接続待ち… (Wi-Fi/SMB を確認してください) */
+    .byte   0x50,0x69,0x63,0x6f,0x3a,0x20,0x53,0x4d,0x42,0x20,0x90,0xda,0x91,0xb1,0x91,0xd2,0x82,0xbf,0x81,0x63,0x20,0x28,0x57,0x69,0x2d,0x46,0x69,0x2f,0x53,0x4d,0x42,0x20,0x82,0xf0,0x8a,0x6d,0x94,0x46,0x82,0xb5,0x82,0xc4,0x82,0xad,0x82,0xbe,0x82,0xb3,0x82,0xa2,0x29
+    .byte   0x1b
+    .ascii  "[17;5H"
+    /* F1: 設定メニュー */
+    .byte   0x46,0x31,0x3a,0x20,0x90,0xdd,0x92,0xe8,0x83,0x81,0x83,0x6a,0x83,0x85,0x81,0x5b
+    .byte   0
+e_row2:
+    .byte   0x1b
+    .ascii  "[14;5H"
+    .byte   0
+e_clear:
+    .byte   0x1b
+    .ascii  "[2J"
+    .byte   0
+m_wifi0:    /* Wi-Fi 未接続 */
+    .byte   0x57,0x69,0x2d,0x46,0x69,0x20,0x96,0xa2,0x90,0xda,0x91,0xb1,0
+m_wifi1:    /* Wi-Fi 接続中 */
+    .byte   0x57,0x69,0x2d,0x46,0x69,0x20,0x90,0xda,0x91,0xb1,0x92,0x86,0
+m_smb0:     /* SMB 接続待ち */
+    .byte   0x53,0x4d,0x42,0x20,0x90,0xda,0x91,0xb1,0x91,0xd2,0x82,0xbf,0
+m_smb1:     /* SMB 接続中 */
+    .byte   0x53,0x4d,0x42,0x20,0x90,0xda,0x91,0xb1,0x92,0x86,0
+m_hds:      /* HDS を開いています */
+    .byte   0x48,0x44,0x53,0x20,0x82,0xf0,0x8a,0x4a,0x82,0xa2,0x82,0xc4,0x82,0xa2,0x82,0xdc,0x82,0xb7,0
+m_nohds:    /* HDS を開けません (config.txt の HDS を確認) */
+    .byte   0x48,0x44,0x53,0x20,0x82,0xf0,0x8a,0x4a,0x82,0xaf,0x82,0xdc,0x82,0xb9,0x82,0xf1,0x20,0x28,0x63,0x6f,0x6e,0x66,0x69,0x67,0x2e,0x74,0x78,0x74,0x20,0x82,0xcc,0x20,0x48,0x44,0x53,0x20,0x82,0xf0,0x8a,0x6d,0x94,0x46,0x29,0
+m_noresp:   /* Pico の応答がありません */
+    .byte   0x50,0x69,0x63,0x6f,0x20,0x82,0xcc,0x89,0x9e,0x93,0x9a,0x82,0xaa,0x82,0xa0,0x82,0xe8,0x82,0xdc,0x82,0xb9,0x82,0xf1,0
+m_changed:  /* HDS が変わりました。Z の電源を入れ直してください */
+    .byte   0x48,0x44,0x53,0x20,0x82,0xaa,0x95,0xcf,0x82,0xed,0x82,0xe8,0x82,0xdc,0x82,0xb5,0x82,0xbd,0x81,0x42,0x5a,0x20,0x82,0xcc,0x93,0x64,0x8c,0xb9,0x82,0xf0,0x93,0xfc,0x82,0xea,0x92,0xbc,0x82,0xb5,0x82,0xc4,0x82,0xad,0x82,0xbe,0x82,0xb3,0x82,0xa2,0
+m_ip:
+    .ascii  "  IP "
+    .byte   0
+m_sec:      /* 秒 */
+    .byte   0x20,0x95,0x62,0x20,0
+m_spin:
+    .ascii  "|/-\\"
+m_pad:
+    .ascii  "          "
+    .byte   0
+    .even
+
+    .end
diff --git a/driver/bootwait1.S b/driver/bootwait1.S
new file mode 100644
index 0000000..933caf8
--- /dev/null
+++ b/driver/bootwait1.S
@@ -0,0 +1,46 @@
+/*
+ * bootwait1.S -- 起動待ちの IPL の前半 (src/bootwait.c、BOOTWAIT_SCREEN)
+ *
+ * Pico が HDS をまだ開けていないとき、HDS の LBA 2 (IPL) の代わりにこれを返す。ROM から来たときの d4 (SCSI ID) を
+ * 控え、後半 (bootwait.S) を SCSI ID 6 の LBA BW_STAGE2 から $2800 に読んで飛ぶ。後半を ID 6 に置くのは、
+ * HDS の LBA 0-31 は 16KB まとめて Z にキャッシュされ、IPL に使えるのが LBA 2-3 の 1KB だけだから。
+ */
+
+    .text
+
+BW_STAGE2   = 0x80                      /* src/bootwait_proto.h */
+V_ID        = 0x3800
+
+entry:
+    bra.w   start
+    .space  4*15
+
+start:
+    move.l  %d4,V_ID.w
+    move.l  #BW_STAGE2,%d2
+    moveq.l #8,%d3                      /* 4KB */
+    moveq.l #6,%d4                      /* SCSI ID 6 */
+    moveq.l #1,%d5
+    movea.w #0x2800,%a1
+    move.l  #0xf5,%d0                   /* SCSIDRV */
+    moveq.l #0x26,%d1                   /* S_READEXT */
+    trap    #15
+    tst.l   %d0
+    bne     error
+    cmpi.l  #0x42573221,0x2800.w        /* "BW2!" */
+    bne     error
+    jmp     0x2804.w
+
+error:
+    lea.l   %pc@(msg),%a1
+    moveq.l #0x21,%d0                   /* B_PRINT */
+    trap    #15
+1:
+    bra     1b
+
+msg:
+    .byte   0x1b
+    .ascii  "[14;5Hbootwait: no reply from the Pico (SCSI ID 6)"
+    .byte   0
+
+    .end
diff --git a/src/bootwait.c b/src/bootwait.c
new file mode 100644
index 0000000..043d71c
--- /dev/null
+++ b/src/bootwait.c
@@ -0,0 +1,216 @@
+/*
+ * bootwait.c -- HDS が開けるまで Z の画面に接続待ちを出して待たせる (BOOTWAIT_SCREEN)
+ *
+ * Z の Linux は HDS を読み始めるとき (電源投入から約 35 秒) に LBA 0-31 (16KB: 署名・IPL・分割表・SCSI ドライバ) を
+ * まとめて読み、ソフトリセットのあとも読み直さずキャッシュから起動する。だから Wi-Fi / SMB が間に合わないとき
+ * そこに偽物を返すと、分割表とドライバが偽物のまま電源を切るまで残る。そこで:
+ *
+ *   1. HDS を開けたら LBA 0-31 を控え (フラッシュ BW_FLASH_OFFSET) と比べ、違えば (HDS のパスと大きさも) 控え直す。
+ *   2. HDS がまだ開けていない間は、LBA 0-31 を控えのとおりに返す。ただし IPL (LBA 2-3) は待ち IPL の前半
+ *      (driver/bootwait1.S、後半 bootwait.S は ID 6 の BW_STAGE2) にする (開けているときに hdsboot に差し替えている
+ *      のと同じ場所)。控えが無ければ
+ *      0014 と同じく NOT READY で待たせる (偽物は返さない)。
+ *   3. 待ち IPL は画面に状態を出しながら ID 6 の BW_BAND を読みに来る (bootwait_proto.h)。開けて控えと同じなら
+ *      本物の IPL を渡す (キャッシュには本物と同じ分割表・ドライバが入っている)。控えと違えば BW_CHANGED を返し、
+ *      待ち IPL は「電源を入れ直してください」と出して止まる (古い分割表のまま起動させない)。
+ *
+ * 書き込みや比較は接続タスク、bw_disk_read / bw_reply は USB タスクから呼ばれる。
+ */
+#include <stdio.h>
+#include <string.h>
+
+#include "bootwait.h"
+#include "bootwait1.inc"                /* driver/bootwait1.S: 待ち IPL の前半 (HDS の LBA 2) */
+#include "bootwait.inc"                 /* driver/bootwait.S: 後半 (ID 6 の BW_STAGE2) */
+
+#define HDR_MAGIC       "X6Z BootSnap v1"
+#define DATA_OFF        4096
+#define DATA_SIZE       (BW_SNAP_SECTS * 512)
+
+struct bw_hdr {
+    char magic[16];
+    uint32_t hash;                      /* 中身 16KB の FNV-1a */
+    uint32_t size_lo, size_hi;          /* HDS の大きさ */
+    uint32_t pad;
+    char path[128];                     /* config の HDS0 */
+};
+
+_Static_assert(sizeof(bootwait1) <= 512, "bootwait1.S must fit in LBA 2");
+_Static_assert(sizeof(bootwait) <= BW_STAGE2_SECTS * 512, "bootwait.S must fit in BW_STAGE2");
+
+static int usable = -1;                 /* 控えが壊れていないか (-1: まだ見ていない) */
+static volatile bool served;            /* この USB の接続で控えを Z に返した */
+static volatile bool checked, match;    /* HDS を開いて比べた / 控えと同じだった */
+static uint32_t ipl_sum;                /* BW_READY で渡す IPL の和 (待ち IPL が確かめる) */
+
+static const struct bw_hdr *hdr(void)
+{
+    return (const struct bw_hdr *)bw_flash_ptr();
+}
+
+static const uint8_t *snap(void)
+{
+    return bw_flash_ptr() + DATA_OFF;
+}
+
+static uint32_t fnv(uint32_t h, const uint8_t *p, int n)
+{
+    while (n-- > 0)
+        h = (h ^ *p++) * 16777619u;
+    return h;
+}
+
+static void put32(uint8_t *p, uint32_t v)
+{
+    p[0] = v >> 24;
+    p[1] = v >> 16;
+    p[2] = v >> 8;
+    p[3] = v;
+}
+
+static uint32_t get32(const uint8_t *p)
+{
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+
+bool bw_usable(const char *path)
+{
+    if (usable < 0)
+        usable = memcmp(hdr()->magic, HDR_MAGIC, sizeof HDR_MAGIC) == 0 &&
+                 hdr()->hash == fnv(2166136261u, snap(), DATA_SIZE);
+    return usable && path[0] != '\0' && strncmp(hdr()->path, path, sizeof hdr()->path) == 0;
+}
+
+int bw_disk_read(uint32_t lba, uint8_t *buf)
+{
+    if (lba >= BW_SNAP_SECTS)
+        return -1;
+    if (lba == 2 || lba == 3) {
+        memset(buf, 0, 512);
+        if (lba == 2)
+            memcpy(buf, bootwait1, sizeof(bootwait1));
+    } else {
+        memcpy(buf, snap() + lba * 512, 512);
+    }
+    served = true;
+    return 0;
+}
+
+int bw_stage2_read(uint32_t lba, uint8_t *buf)
+{
+    uint32_t off = (lba - BW_STAGE2) * 512;
+    memset(buf, 0, 512);
+    if (lba < BW_STAGE2 || lba >= BW_STAGE2 + BW_STAGE2_SECTS)
+        return -1;
+    if (off < sizeof(bootwait))
+        memcpy(buf, bootwait + off, sizeof(bootwait) - off < 512 ? sizeof(bootwait) - off : 512);
+    return 0;
+}
+
+void bw_check(const char *path, uint64_t size, bw_read_fn rd, void *ctx)
+{
+    static uint8_t buf[512];
+    bool same = bw_usable(path) && hdr()->size_lo == (uint32_t)size && hdr()->size_hi == (uint32_t)(size >> 32);
+
+    for (int i = 0; i < BW_SNAP_SECTS; i++) {
+        if (rd(ctx, i, buf) != 0) {
+            printf("bootwait: cannot read HDS LBA %d\n", i);
+            match = false;
+            checked = true;
+            return;
+        }
+        if (same && memcmp(buf, snap() + i * 512, 512) != 0)
+            same = false;
+    }
+    match = same;
+    checked = true;
+    if (same) {
+        printf("bootwait: snapshot matches %s\n", path);
+        return;
+    }
+
+    /* 控え直す。見出しを最後に書くので、途中で止まっても壊れた控えは使われない */
+    printf("bootwait: writing snapshot of %s\n", path);
+    bw_flash_erase(0, BW_FLASH_SIZE);
+    uint32_t h = 2166136261u;
+    for (int i = 0; i < BW_SNAP_SECTS; i++) {
+        if (rd(ctx, i, buf) != 0)
+            return;
+        h = fnv(h, buf, 512);
+        bw_flash_program(DATA_OFF + i * 512, buf, 512);
+    }
+    static uint8_t hb[256];
+    struct bw_hdr *n = (struct bw_hdr *)hb;
+    memset(hb, 0xff, sizeof hb);
+    memset(n, 0, sizeof *n);
+    memcpy(n->magic, HDR_MAGIC, sizeof HDR_MAGIC);
+    n->hash = h;
+    n->size_lo = (uint32_t)size;
+    n->size_hi = (uint32_t)(size >> 32);
+    strncpy(n->path, path, sizeof n->path - 1);
+    bw_flash_program(0, hb, sizeof hb);
+    usable = -1;
+}
+
+/* IPL (HDS の LBA 2-3) の 1 セクタ。控えと同じならフラッシュから (SMB を読まない) */
+static int ipl_sector(int k, uint8_t *buf, bw_read_fn rd, void *ctx)
+{
+    if (match) {
+        memcpy(buf, snap() + (2 + k) * 512, 512);
+        return 0;
+    }
+    return rd(ctx, 2 + k, buf);
+}
+
+void bw_reply(uint32_t lba, uint8_t *buf, int hds_open, int sysstat, uint32_t ip, uint32_t uptime_ms,
+              bw_read_fn rd, void *ctx)
+{
+    uint32_t j = (lba - BW_BAND) % BW_STRIDE;
+    int st;
+
+    if (!hds_open)
+        st = sysstat >= 5 ? BW_NOHDS : BW_WAIT;         /* 5 = STAT_CONFIGURED */
+    else if (!checked)
+        st = BW_WAIT;
+    else if (served && !match)
+        st = BW_CHANGED;
+    else
+        st = BW_READY;
+
+    memset(buf, 0, 512);
+    if (j == 0) {
+        if (st == BW_READY) {
+            /* 和を先に出す (セクタ 1-2 はこのあとすぐ読まれる。READY は戻らないので同じ中身) */
+            uint32_t sum = 0;
+            for (int k = 0; k < 2; k++) {
+                if (ipl_sector(k, buf, rd, ctx) != 0) {
+                    st = BW_WAIT;
+                    break;
+                }
+                for (int i = 0; i < 512; i += 4)
+                    sum += get32(buf + i);
+            }
+            ipl_sum = sum;
+            memset(buf, 0, 512);
+        }
+        memcpy(buf, "X6BW", 4);
+        buf[4] = st;
+        buf[5] = sysstat;
+        put32(buf + 8, ip);
+        put32(buf + 12, uptime_ms);
+        put32(buf + 16, lba);
+        put32(buf + 20, st == BW_READY ? ipl_sum : 0);
+    } else if (j <= 2 && st == BW_READY) {
+        if (ipl_sector(j - 1, buf, rd, ctx) != 0)
+            memset(buf, 0, 512);
+    }
+}
+
+const char *bw_state(const char *path)
+{
+    if (!checked)
+        return bw_usable(path) ? "stored" : "none";
+    if (served)
+        return match ? "served" : "changed";
+    return match ? "ok" : "updated";
+}
diff --git a/src/bootwait.h b/src/bootwait.h
new file mode 100644
index 0000000..c69d1b3
--- /dev/null
+++ b/src/bootwait.h
@@ -0,0 +1,31 @@
+#ifndef _BOOTWAIT_H_
+#define _BOOTWAIT_H_
+#include <stdint.h>
+#include <stdbool.h>
+#include "bootwait_proto.h"
+
+/* BOOTWAIT_SCREEN=1 (cmake -DBOOTWAIT_SCREEN=ON、BOOTWAIT と一緒に既定オン): HDS が開けるまで、控えておいた HDS の先頭と
+   待ち IPL で起動を始め、Z の画面に接続待ちを出す (bootwait.c) */
+#ifndef BOOTWAIT_SCREEN
+#define BOOTWAIT_SCREEN 0
+#endif
+
+#define BW_FLASH_OFFSET 0x1e0000        /* 見出し 4KB + 中身 16KB (0x1e0000-0x1e4fff)。設定は 0x1f0000 */
+#define BW_FLASH_SIZE   (4096 + BW_SNAP_SECTS * 512)
+
+typedef int (*bw_read_fn)(void *ctx, uint32_t lba, uint8_t *buf);   /* HDS を 1 セクタ読む (0 なら成功) */
+
+bool bw_usable(const char *path);                       /* 控えが壊れておらず、この HDS のものか */
+int bw_disk_read(uint32_t lba, uint8_t *buf);           /* 控えから LBA 0-31 を返す (2 は待ち IPL の前半)。bw_usable のときだけ */
+int bw_stage2_read(uint32_t lba, uint8_t *buf);         /* ID 6 の BW_STAGE2: 待ち IPL の後半 */
+void bw_check(const char *path, uint64_t size, bw_read_fn rd, void *ctx);   /* HDS を開いたあと: 比べて、違えば控え直す */
+void bw_reply(uint32_t lba, uint8_t *buf, int hds_open, int sysstat, uint32_t ip, uint32_t uptime_ms,
+              bw_read_fn rd, void *ctx);                /* ID 6 の BW_BAND の読み込みに答える */
+const char *bw_state(const char *path);                 /* status 用: none / stored / ok / updated / served / changed */
+
+/* 書き込み (ホスト試験では差し替える) */
+void bw_flash_erase(uint32_t off, uint32_t len);
+void bw_flash_program(uint32_t off, const uint8_t *data, uint32_t len);
+const uint8_t *bw_flash_ptr(void);
+
+#endif
diff --git a/src/bootwait_pico.c b/src/bootwait_pico.c
new file mode 100644
index 0000000..87011ca
--- /dev/null
+++ b/src/bootwait_pico.c
@@ -0,0 +1,53 @@
+/*
+ * bootwait_pico.c -- bootwait.c の控えをフラッシュに書く部分 (Pico)。ホスト試験では test/bootwait が差し替える
+ *
+ * flash_safe_execute (pico_flash) の中で消して書く。このファームの FreeRTOS は 1 コア (コア 1 は動かさない) なので、
+ * 実際には割り込みを止めるだけになる (config_write と同じ)。消すのは 1 回に 4KB (約 45ms) ずつ
+ */
+#include <stdio.h>
+#include "pico/stdlib.h"
+#include "pico/flash.h"
+#include "hardware/flash.h"
+
+#include "bootwait.h"
+
+struct op {
+    bool erase;
+    uint32_t off, len;
+    const uint8_t *data;
+};
+
+static void do_op(void *p)
+{
+    const struct op *o = p;
+    if (o->erase)
+        flash_range_erase(BW_FLASH_OFFSET + o->off, o->len);
+    else
+        flash_range_program(BW_FLASH_OFFSET + o->off, o->data, o->len);
+}
+
+static void run(struct op *o)
+{
+    int rc = flash_safe_execute(do_op, o, 1000);
+    if (rc != PICO_OK)
+        printf("bootwait: flash %s 0x%lx failed (%d)\n", o->erase ? "erase" : "program", (unsigned long)o->off, rc);
+}
+
+void bw_flash_erase(uint32_t off, uint32_t len)
+{
+    for (uint32_t a = 0; a < len; a += FLASH_SECTOR_SIZE) {
+        struct op o = { .erase = true, .off = off + a, .len = FLASH_SECTOR_SIZE };
+        run(&o);
+    }
+}
+
+void bw_flash_program(uint32_t off, const uint8_t *data, uint32_t len)
+{
+    struct op o = { .erase = false, .off = off, .len = len, .data = data };
+    run(&o);
+}
+
+const uint8_t *bw_flash_ptr(void)
+{
+    return (const uint8_t *)(XIP_BASE + BW_FLASH_OFFSET);
+}
diff --git a/src/bootwait_proto.h b/src/bootwait_proto.h
new file mode 100644
index 0000000..e1bbb00
--- /dev/null
+++ b/src/bootwait_proto.h
@@ -0,0 +1,28 @@
+#ifndef _BOOTWAIT_PROTO_H_
+#define _BOOTWAIT_PROTO_H_
+
+/* 起動待ちの IPL (driver/bootwait.S) と Pico (bootwait.c) の取り決め。数値はビッグエンディアン
+ *
+ * 待ち IPL は SCSI ID 6 の BW_BAND〜BW_BAND_END のどこか (毎回違う番地) から 3 セクタ読む:
+ *   セクタ 0: +0 "X6BW" +4 状態 (BW_*) +5 sysstatus +6 0 +8 Pico の IP (4) +12 Pico の起動からの ms (4) +16 読んだ LBA (4)
+ *   セクタ 1-2: 状態が BW_READY なら本物の IPL (HDS の LBA 2-3、1KB)
+ * Z の Linux は読んだページをキャッシュするので、同じ番地は二度と読まない (時刻から決め、BW_STRIDE ずつ離す。
+ * Linux は 1 回に 16KB 先読みするので、続きの番地にすると先読みした古い答えを読んでしまう)。
+ */
+#define BW_BAND         0x40000         /* ID 6 の LBA。settingui (0x100-0x1ff) と netpipe (0x100000-) の間 */
+#define BW_BAND_END     0x100000
+#define BW_STRIDE       64              /* セクタ (32KB) */
+#define BW_SLOTS        ((BW_BAND_END - BW_BAND) / BW_STRIDE)  /* 12288 */
+#define BW_REPLY_SECTS  3
+
+#define BW_WAIT         0               /* まだ (sysstatus を見て表示) */
+#define BW_READY        1               /* セクタ 1-2 の IPL を $2000 に置いて飛ぶ */
+#define BW_CHANGED      2               /* HDS の先頭が控えと違う: 電源を入れ直してもらう */
+#define BW_NOHDS        3               /* SMB にはつながったが HDS を開けない */
+
+#define BW_STAGE2       0x80            /* ID 6 の LBA: 待ち IPL の後半 (driver/bootwait.S、4KB まで。中身は変わらない) */
+#define BW_STAGE2_SECTS 8
+
+#define BW_SNAP_SECTS   32              /* 控える HDS の先頭 (LBA 0-31、16KB: 署名・IPL・分割表・SCSI ドライバ) */
+
+#endif
