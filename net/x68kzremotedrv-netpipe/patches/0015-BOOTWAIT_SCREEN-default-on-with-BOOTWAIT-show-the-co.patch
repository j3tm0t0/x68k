+        skip_count++;                   /* netpipe / scsiremote の帯、待ち IPL の問い合わせ (BW_BAND / BW_STAGE2) */
         return;
     }
     if (cur_open && (cur.kind != dir || cur.lun != lun || lba != cur.lba + cur.n))
