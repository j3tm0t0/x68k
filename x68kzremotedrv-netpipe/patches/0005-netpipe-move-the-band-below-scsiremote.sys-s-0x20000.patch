From a1bbb2517e7d6a1213f7bcb92f9c0084ac7252f2 Mon Sep 17 00:00:00 2001
From: moto <j3tm0t0@gmail.com>
Date: Wed, 21 Oct 2026 09:30:32 +0900
Subject: [PATCH 5/8] netpipe: move the band below scsiremote.sys's
 0x200000-0x3fffff

Requests go to 0x1000 and responses are read from 0x2000-0x1ffff7 (about
1GB). The previous band overlapped scsiremote.sys's reads and hung its
init.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PrGdt1XK1exBgERrMmLA1u
---
 src/netpipe.h      | 7 ++++---
 src/virtual_disk.c | 5 ++---
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/src/netpipe.h b/src/netpipe.h
index a365389..65573d5 100644
--- a/src/netpipe.h
+++ b/src/netpipe.h
@@ -4,9 +4,10 @@
 #include <stdint.h>
 
 /* SCSI ID 6 (DTYPE_REMOTECOMM) の中で netpipe が使う LBA */
-#define NETPIPE_WLBA    0x100000        /* 要求を書く (8 セクタまで) */
-#define NETPIPE_RLBA    0x110000        /* 応答を読む (0x110000～0x3ffff7 のどこでも、8 セクタ周期)。 */
-#define NETPIPE_REND    0x3ffff8        /* 読む位置は毎回変える: Z 側が読み込みをキャッシュする (帯は約 1.5GB) */
+#define NETPIPE_WLBA    0x1000          /* 要求を書く (8 セクタまで) */
+#define NETPIPE_RLBA    0x2000          /* 応答を読む (0x2000～0x1ffff7 のどこでも、8 セクタ周期)。 */
+#define NETPIPE_REND    0x200000        /* 読む位置は毎回変える: Z 側が読み込みをキャッシュする (帯は約 1GB)。
+                                           0x200000 以降は scsiremote.sys が使う。ID6 は 2GB より大きくできない */
 
 int netpipe_write(uint32_t lba, const uint8_t *buf);
 int netpipe_read(uint32_t lba, uint8_t *buf);
diff --git a/src/virtual_disk.c b/src/virtual_disk.c
index c0ce967..5d81a62 100644
--- a/src/virtual_disk.c
+++ b/src/virtual_disk.c
@@ -229,9 +229,8 @@ int vd_init(void)
 
     /* SCSI ID 6 : for remote communication */
     diskinfo[6].type = DTYPE_REMOTECOMM;
-    /* netpipe が 0x110000～0x3ffff7 セクタ (約 1.5GB) を応答の読み出しに使う。Z 側の Linux が読み込みを
-       キャッシュするので、広い帯を回らないと、一巡したところで古い応答が返る。
-       2GB より大きくすると Z がディスク構成を受け付けず、起動できなくなる (0xfffffe00 で確認) */
+    /* 2GB より大きくすると Z がディスク構成を受け付けず、起動できなくなる (0xfffffe00 で確認)。
+       netpipe の帯は netpipe.h */
     diskinfo[6].size = 0x80000000;
 
     for (int i = 0; i < 7; i++) {
