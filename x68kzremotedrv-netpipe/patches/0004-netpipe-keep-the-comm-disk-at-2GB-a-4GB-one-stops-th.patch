From 29450942efc07203b7632fea193720d4b916bdc7 Mon Sep 17 00:00:00 2001
From: moto <j3tm0t0@gmail.com>
Date: Wed, 21 Oct 2026 09:24:54 +0900
Subject: [PATCH 4/8] netpipe: keep the comm disk at 2GB; a 4GB one stops the Z
 from booting

With ID6 at 0xfffffe00 bytes the Z refused the whole disk set and showed
"cannot boot from disk". Go back to 0x80000000 and read responses from
0x110000-0x3ffff7 (about 1.5GB) instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PrGdt1XK1exBgERrMmLA1u
---
 src/netpipe.h      | 4 ++--
 src/virtual_disk.c | 7 ++++---
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/src/netpipe.h b/src/netpipe.h
index 9633f92..a365389 100644
--- a/src/netpipe.h
+++ b/src/netpipe.h
@@ -5,8 +5,8 @@
 
 /* SCSI ID 6 (DTYPE_REMOTECOMM) の中で netpipe が使う LBA */
 #define NETPIPE_WLBA    0x100000        /* 要求を書く (8 セクタまで) */
-#define NETPIPE_RLBA    0x400000        /* 応答を読む (0x400000～0x7ffff7 のどこでも、8 セクタ周期)。 */
-#define NETPIPE_REND    0x7ffff8        /* 読む位置は毎回変える: Z 側が読み込みをキャッシュする (帯は 2GB = Z のメモリより広く) */
+#define NETPIPE_RLBA    0x110000        /* 応答を読む (0x110000～0x3ffff7 のどこでも、8 セクタ周期)。 */
+#define NETPIPE_REND    0x3ffff8        /* 読む位置は毎回変える: Z 側が読み込みをキャッシュする (帯は約 1.5GB) */
 
 int netpipe_write(uint32_t lba, const uint8_t *buf);
 int netpipe_read(uint32_t lba, uint8_t *buf);
diff --git a/src/virtual_disk.c b/src/virtual_disk.c
index 69bf7de..c0ce967 100644
--- a/src/virtual_disk.c
+++ b/src/virtual_disk.c
@@ -229,9 +229,10 @@ int vd_init(void)
 
     /* SCSI ID 6 : for remote communication */
     diskinfo[6].type = DTYPE_REMOTECOMM;
-    /* netpipe が 0x400000 セクタ以降 (2GB 分) を応答の読み出しに使う。Z 側の Linux が読み込みを
-       キャッシュするので、Z のメモリより広い帯を回らないと、一巡したところで古い応答が返る */
-    diskinfo[6].size = 0xfffffe00;
+    /* netpipe が 0x110000～0x3ffff7 セクタ (約 1.5GB) を応答の読み出しに使う。Z 側の Linux が読み込みを
+       キャッシュするので、広い帯を回らないと、一巡したところで古い応答が返る。
+       2GB より大きくすると Z がディスク構成を受け付けず、起動できなくなる (0xfffffe00 で確認) */
+    diskinfo[6].size = 0x80000000;
 
     for (int i = 0; i < 7; i++) {
         diskinfo[i].sects = (diskinfo[i].size + SECTOR_SIZE - 1) / SECTOR_SIZE;
-- 
