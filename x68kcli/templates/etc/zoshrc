# /etc/zoshrc -- zosh.x (Z-OS のシェル) の共通設定。そのあと ~/zosh.rc を読む。関数は 1 行で書く
alias ls='ls -F'
alias ll='ls -alF'
alias la='ls -aF'
alias dir='ls -alF'
alias vi='vim.x -T builtin_x68k'
alias vim='vim.x -T builtin_x68k'
alias less='vim.x -T builtin_x68k -R'
alias awk='gawk.x'
alias h='history'
# C コンパイラ: gcc = rcc.x (RCC_HOST の elf2x68k の gcc でコンパイル。つながらなければ Z の gcc.x $@ -lgcc2)、
# Z だけでコンパイルするなら gcc.x ... -lgcc2 (真里子版 1.42。-lgcc2 を付けないとリンクで __ltdf2 などが足りない)、
# gcc295 = GCC 2.95.2 (68020 以上専用)、cc = XC 2.1
# RCC_HOST=192.168.1.10   (コンパイルを任せる機械。無ければ黙って Z の gcc.x)
gcc() { rcc.x $@; }
gcc295() { A:/usr/gcc295/gcc.x -IA:/usr/gcc295/include $@; }
cc() { include=A:/xc/include; lib=A:/xc/lib; A:/xc/cc/cc.x $@; include=A:/usr/include; lib=A:/usr/lib; }
