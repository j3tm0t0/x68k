% KeyWitch 環境定義ファイル
%
% ファイル名: us.env
%       内容: US (ASCII) 配列の USB キーボードを X68000 Z につないだとき用。
%             KeyWitch 付属の ascii.env をもとに、X68000 Z で `~ キーが BREAK の
%             スキャンコードになる問題を INS と入れ替えて回避する (Noobru Harada 氏の
%             us_HHKB.env https://www.nharada.com/programming/x68000z_usHHKB.html を参考)。
%             CONFIG.SYS: DEVICE = \USR\BIN\KeyWitch.x -x -e \ETC\KEYWITCH\us.env
%             zsh から:   uskey / jiskey (alias)

&name 80 かな
&name 81 ローマ字
&name 83 CAPS
&name 88 SHIFT
&name 89 CTRL
&name 61 BREAK
&name 5E INS

% `~ キー (X68000 Z では BREAK として届く) と INS を入れ替える
&rule
&target     BREAK   INS
&code       INS BREAK

% CTRL+C で BREAK
&break CTRL=1 SHIFT=0 2C=1
&sbreak CTRL=1 SHIFT=1 2C=1

&target \
 02 03 04 05 06 07 08 09 0A 0B 0C 0D 29 5E \
  11 12 13 14 15 16 17 18 19 1A 1B 1C \
   1E 1F 20 21 22 23 24 25 26 27 28 \
    2A 2B 2C 2D 2E 2F 30 31 32 33

&rule かな=0 ローマ字=1 SHIFT=1 CTRL=0
&char \
 !  @  #  \$ \% \^ &  *  (  )  _  +  |  ~ \
  q  w  e  r  t  y  u  i  o  p  {  }  \
   a  s  d  f  g  h  j  k  l  :  \"  \
    z  x  c  v  b  n  m  <  >  ?

&rule かな=0 ローマ字=1 SHIFT=0 CTRL=0
&char \
 1  2  3  4  5  6  7  8  9  0  -  =  \\ ` \
  Q  W  E  R  T  Y  U  I  O  P  [  ]  \
   A  S  D  F  G  H  J  K  L  ;  '  \
    Z  X  C  V  B  N  M  ,  .  /

&rule かな=0 ローマ字=0 CAPS=1 SHIFT=1 CTRL=0
&char \
 !  @  #  \$ \% \^ &  *  (  )  _  +  |  ~ \
  q  w  e  r  t  y  u  i  o  p  {  }  \
   a  s  d  f  g  h  j  k  l  :  \"  \
    z  x  c  v  b  n  m  <  >  ?

&rule かな=0 ローマ字=0 CAPS=1 SHIFT=0 CTRL=0
&char \
 1  2  3  4  5  6  7  8  9  0  -  =  \\ ` \
  Q  W  E  R  T  Y  U  I  O  P  [  ]  \
   A  S  D  F  G  H  J  K  L  ;  '  \
    Z  X  C  V  B  N  M  ,  .  /

&rule かな=0 ローマ字=0 CAPS=0 SHIFT=1 CTRL=0
&char \
 !  @  #  \$ \% \^ &  *  (  )  _  +  |  ~ \
  Q  W  E  R  T  Y  U  I  O  P  {  }  \
   A  S  D  F  G  H  J  K  L  :  \"  \
    Z  X  C  V  B  N  M  <  >  ?

&rule かな=0 ローマ字=0 CAPS=0 SHIFT=0 CTRL=0
&char \
 1  2  3  4  5  6  7  8  9  0  -  =  \\ ` \
  q  w  e  r  t  y  u  i  o  p  [  ]  \
   a  s  d  f  g  h  j  k  l  ;  '  \
    z  x  c  v  b  n  m  ,  .  /

&rule CTRL=1
&char \
 ^@ ^@ ^@ ^@ ^@ ^^ ^@ ^@ ^@ ^@ ^_ ^@ ^\ ^@ \
  ^Q ^W ^E ^R ^T ^Y ^U ^I ^O ^P ^[ ^] \
   ^A ^S ^D ^F ^G ^H ^J ^K ^L ^@ ^@  \
    ^Z ^X ^C ^V ^B ^N ^M ^@ ^@ ^?
